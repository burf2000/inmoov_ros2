<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>inmoov_hardware</name>
  <version>0.1.0</version>
  <description>
    ros2_control SystemInterface that drives the real InMoov humanoid through MyRobotLab,
    plus the shared URDF-joint to MRL-servo mapping and a /joint_states relay for the
    RViz slider path. Runs entirely on the ROS2 machine; nothing is installed on the pi5.
  </description>
  <maintainer email="simon@burf.co">Simon Burfield</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>sensor_msgs</depend>
  <depend>yaml-cpp-vendor</depend>
  <depend>libcurl-dev</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
