<?xml version="1.0"?>
<!--
  REAL-HARDWARE ros2_control block for the InMoov.

  This only defines a macro. It is inert unless the top-level robot xacro invokes it,
  which it does only when use_real_hardware:=true. inmoov_description therefore still
  builds and is still usable (sim, MoveIt, a plain viewer) with no dependency on
  inmoov_hardware — the plugin is named as a string and resolved by pluginlib at runtime.

  The joints listed here are exactly the 28 that have a servo behind them, which is also
  exactly what inmoov_bringup/config/inmoov_controllers.yaml lists. The other ~25 URDF
  joints (finger sub-links, the second eye pan) are geometry only.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="inmoov_real_ros2_control"
               params="name:='inmoov_system'
                       mrl_host:='pi5-inmoov.local'
                       mrl_port:=8888
                       enabled_groups:='head'
                       dry_run:='false'
                       joint_map:=''
                       refresh_limits:='true'
                       hold_refresh_s:=0.5
                       move_epsilon_deg:=1.0
                       require_mrl:='true'">

    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>inmoov_hardware/InmoovSystem</plugin>

        <!-- Where MyRobotLab lives. The driver runs on the ROS2 machine and speaks to
             MRL's HTTP API across the LAN; nothing is installed on the pi5. -->
        <param name="mrl_host">${mrl_host}</param>
        <param name="mrl_port">${mrl_port}</param>

        <!-- Staged bring-up. Only joints in these groups are ever commanded; everything
             else is left exactly where it is. Groups: head, eyes, rightArm, leftArm,
             rightHand, leftHand, torso. DEFAULT IS HEAD ONLY — widen deliberately, and
             only once the direction signs for that group have been confirmed by eye. -->
        <param name="enabled_groups">${enabled_groups}</param>

        <!-- true = log every intended servo move and send NOTHING. Prove the pipeline
             here first. -->
        <param name="dry_run">${dry_run}</param>

        <!-- Empty means "find config/inmoov_joint_map.yaml in the inmoov_hardware share
             dir at runtime". Set it to override with your own table. -->
        <param name="joint_map">${joint_map}</param>

        <!-- Re-read each servo's calibrated min/max/rest from MRL on activation, so a
             recalibration in MRL is picked up without editing the YAML. -->
        <param name="refresh_limits">${refresh_limits}</param>

        <!-- InMoov servos droop if they are not re-commanded, so a held pose is
             re-asserted this often even when nothing changed. -->
        <param name="hold_refresh_s">${hold_refresh_s}</param>
        <param name="move_epsilon_deg">${move_epsilon_deg}</param>

        <!-- Refuse to activate if MRL is unreachable. Set false only for desk testing. -->
        <param name="require_mrl">${require_mrl}</param>
      </hardware>

      <!-- head -->
      <xacro:inmoov_pos_joint jname="head_pan_joint"/>
      <xacro:inmoov_pos_joint jname="head_tilt_joint"/>
      <xacro:inmoov_pos_joint jname="head_roll_joint"/>
      <xacro:inmoov_pos_joint jname="jaw_joint"/>

      <!-- eyes -->
      <xacro:inmoov_pos_joint jname="eyes_pan_joint"/>
      <xacro:inmoov_pos_joint jname="eyes_tilt_joint"/>

      <!-- torso -->
      <xacro:inmoov_pos_joint jname="waist_pan_joint"/>
      <xacro:inmoov_pos_joint jname="waist_roll_joint"/>

      <!-- right arm + wrist -->
      <xacro:inmoov_pos_joint jname="r_shoulder_lift_joint"/>
      <xacro:inmoov_pos_joint jname="r_shoulder_out_joint"/>
      <xacro:inmoov_pos_joint jname="r_upper_arm_roll_joint"/>
      <xacro:inmoov_pos_joint jname="r_elbow_flex_joint"/>
      <xacro:inmoov_pos_joint jname="r_wrist_roll_joint"/>

      <!-- left arm + wrist -->
      <xacro:inmoov_pos_joint jname="l_shoulder_lift_joint"/>
      <xacro:inmoov_pos_joint jname="l_shoulder_out_joint"/>
      <xacro:inmoov_pos_joint jname="l_upper_arm_roll_joint"/>
      <xacro:inmoov_pos_joint jname="l_elbow_flex_joint"/>
      <xacro:inmoov_pos_joint jname="l_wrist_roll_joint"/>

      <!-- right hand: one servo per finger -->
      <xacro:inmoov_pos_joint jname="r_thumb_joint"/>
      <xacro:inmoov_pos_joint jname="r_index_joint"/>
      <xacro:inmoov_pos_joint jname="r_middle_joint"/>
      <xacro:inmoov_pos_joint jname="r_ring_joint"/>
      <xacro:inmoov_pos_joint jname="r_pinky_joint"/>

      <!-- left hand: one servo per finger -->
      <xacro:inmoov_pos_joint jname="l_thumb_joint"/>
      <xacro:inmoov_pos_joint jname="l_index_joint"/>
      <xacro:inmoov_pos_joint jname="l_middle_joint"/>
      <xacro:inmoov_pos_joint jname="l_ring_joint"/>
      <xacro:inmoov_pos_joint jname="l_pinky_joint"/>
    </ros2_control>
  </xacro:macro>

  <!-- Position command + position state. No effort/velocity: MRL takes a target angle and
       reports nothing back, so claiming any other interface would be a lie. -->
  <xacro:macro name="inmoov_pos_joint" params="jname">
    <joint name="${jname}">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
  </xacro:macro>

</robot>
