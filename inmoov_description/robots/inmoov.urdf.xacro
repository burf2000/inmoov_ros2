<?xml version="1.0"?>

<robot name="inmoov" xmlns:xacro="http://ros.org/wiki/xacro">

<xacro:include filename="$(find inmoov_description)/urdf/config.joints.urdf.xacro" />
<xacro:include filename="$(find inmoov_description)/urdf/config.inertial.urdf.xacro" />
<xacro:include filename="$(find inmoov_description)/urdf/materials.urdf.xacro" />
<xacro:include filename="$(find inmoov_description)/urdf/asmBase.urdf.xacro" />
<xacro:include filename="$(find inmoov_description)/urdf/asmTorso.urdf.xacro" />
<xacro:include filename="$(find inmoov_description)/urdf/asmHead.urdf.xacro" />
<xacro:include filename="$(find inmoov_description)/urdf/asmEye.urdf.xacro" />
<xacro:include filename="$(find inmoov_description)/urdf/asmFace.urdf.xacro" />
<xacro:include filename="$(find inmoov_description)/urdf/asmArm.urdf.xacro" />
<xacro:include filename="$(find inmoov_description)/urdf/asmHand.urdf.xacro" />

<!-- ==========================================================================
     Control back-end selection.

     use_real_hardware:=false (default) -> Gazebo Sim ros2_control, exactly as before.
     use_real_hardware:=true            -> the inmoov_hardware SystemInterface that drives
                                           the physical robot through MyRobotLab, and NO
                                           Gazebo plugin at all (there is nothing to
                                           simulate when the real robot is the plant).

     Both files only DEFINE macros, so including them unconditionally is free; only the
     invocation below is gated. inmoov_description gains no dependency on inmoov_hardware
     from this — the plugin is a string that pluginlib resolves at run time.
     ========================================================================== -->
<xacro:arg name="use_real_hardware" default="false"/>
<xacro:arg name="mrl_host"          default="pi5-inmoov.local"/>
<xacro:arg name="mrl_port"          default="8888"/>
<xacro:arg name="enabled_groups"    default="head,rightArm,leftArm,rightHand,leftHand,torso"/>
<xacro:arg name="dry_run"           default="false"/>
<xacro:arg name="joint_map"         default=""/>

<xacro:include filename="$(find inmoov_description)/urdf/inmoov.gazebo.xacro" />
<xacro:include filename="$(find inmoov_description)/urdf/inmoov.ros2_control.xacro" />

<xacro:if value="$(arg use_real_hardware)">
  <xacro:inmoov_real_ros2_control
      mrl_host="$(arg mrl_host)"
      mrl_port="$(arg mrl_port)"
      enabled_groups="$(arg enabled_groups)"
      dry_run="$(arg dry_run)"
      joint_map="$(arg joint_map)"/>
</xacro:if>
<xacro:unless value="$(arg use_real_hardware)">
  <xacro:inmoov_gazebo_control/>
</xacro:unless>

  <link name="world"/>
    <xacro:virtual_inertial/>


  <joint name="fixed" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="0.11" radius="0.26"/>
      </geometry> 
      <origin rpy="0 0 0" xyz="0 0 0.055"/>
      <xacro:base_color/>
    </visual>
  
    <collision>
      <geometry>
        <cylinder length="0.11" radius="0.26"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.055"/>
    </collision>
</link>

  <joint name="base_to_pedestal_link" type="fixed">
    <parent link="base_link"/>
    <child link="pedestal_link"/>
    <origin rpy="0 0 0"  xyz="0 0 0"/>
  </joint>

  <link name="pedestal_link">
    <xacro:virtual_inertial/>

    <visual>
      <geometry>
        <cylinder length="0.94" radius="0.0254"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.58"/>
      <xacro:base_color/>
    </visual>
  
    <collision>
      <geometry>
        <cylinder length="0.94" radius="0.0254"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.58"/>
    </collision>
</link>

  <link name="head_tilt_link">
    <visual>
      <geometry>
        <mesh filename="package://inmoov_description/meshes/virtual.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 0 3.1415" xyz="0 0 0"/>
      <xacro:frame_color/>
    </visual>
    <xacro:virtual_inertial/>
  
    <collision>
      <geometry>
        <mesh filename="package://inmoov_description/meshes/virtual.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 0 3.1415" xyz="0 0 0"/>
    </collision>
</link>

  <joint name="pedestal_to_mid_stomach_joint" type="fixed">
    <parent link="pedestal_link"/>
    <child link="mid_stomach_link"/>
     <origin rpy="0 0 0"  xyz="0 0 0"/>
  </joint>

  <xacro:torso covers="yes" />

  <joint name="head_roll_joint" type="revolute">
   <axis xyz="1 0 0"/>
   <limit effort="1000.0" lower="${head_roll_joint_lower}" upper="${head_roll_joint_upper}" velocity="${head_roll_joint_velocity}" />
   <origin rpy="0 0 3.1415" xyz="-0.0315  -0.001 0.4551"/>
   <parent link="torso_link"/>
   <child link="head_tilt_link"/>
  </joint>


  <joint name="head_tilt_joint" type="revolute">
   <axis xyz="0 1 0"/>
   <limit effort="10000.0" lower="${head_tilt_joint_lower}" upper="${head_tilt_joint_upper}" velocity="${head_tilt_joint_velocity}" />
   <origin rpy="0 0 3.1415" xyz="0 0 0"/>
   <parent link="head_tilt_link"/>
   <child link="head_base_link"/>
  </joint>

  <xacro:head covers="yes" />

  <xacro:face covers="yes" />

  <joint name="face_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.0637 0 0.079"/>
    <parent link="skull_link"/>
    <child link="face_link"/>
  </joint>

  <xacro:arm side="r" flip="1" covers="yes" />

  <joint name="r_shoulder_out_joint" type="revolute">
   <axis xyz="1 0 0"/>
   <limit effort="10000.0" lower="${r_shoulder_out_joint_lower}" upper="${r_shoulder_out_joint_upper}" velocity="${r_shoulder_out_joint_velocity}" />
   <origin rpy="0 0 0" xyz="0 -0.143 0.298"/>
   <parent link="torso_link"/>
   <child link="r_shoulder_base_link"/>
  </joint>

  <xacro:hand side="r" flip="1" covers="yes" />

  <joint name="r_wrist_roll_joint" type="revolute">
   <axis xyz="0 0 1"/>
   <limit effort="10000.0" lower="${r_wrist_roll_joint_lower}" upper="${r_wrist_roll_joint_upper}" velocity="${r_wrist_roll_joint_velocity}" />
   <origin rpy="0 0 0" xyz="-0.0144 0.01  -0.2885"/>
   <parent link="r_forearm_link"/>
   <child link="r_hand_link"/>
  </joint>

  <xacro:arm side="l" flip="-1" covers="yes" />

  <joint name="l_shoulder_out_joint" type="revolute">
   <axis xyz="1 0 0"/>
   <limit effort="10000.0" lower="${l_shoulder_out_joint_lower}" upper="${l_shoulder_out_joint_upper}" velocity="${l_shoulder_out_joint_velocity}" />
   <origin rpy="0 0 0" xyz="0 0.143 0.298"/>
   <parent link="torso_link"/>
   <child link="l_shoulder_base_link"/>
  </joint>

  <xacro:hand side="l" flip="-1" covers="yes" />

  <joint name="l_wrist_roll_joint" type="revolute">
   <axis xyz="0 0 1"/>
   <limit effort="10000.0" lower="${l_wrist_roll_joint_lower}" upper="${l_wrist_roll_joint_upper}" velocity="${l_wrist_roll_joint_velocity}" />
   <origin rpy="0 0 0" xyz="-0.0144 -0.01  -0.2885"/>
   <parent link="l_forearm_link"/>
   <child link="l_hand_link"/>
  </joint>

</robot>
